generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?   
  stars         Int       @default(0) 
  role          Role      @default(TALENT) 
  
  profile       Profile?
  skills        Skill[]   
  unlocks       LeadUnlock[] 
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Profile {
  id            String    @id @default(cuid())
  bio           String?   @db.Text
  cvUrl         String?   
  githubUrl     String?
  linkedinUrl   String?
  position      String?   
  
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id            String    @id @default(cuid())
  name          String    @unique
  users         User[]
}

model LeadUnlock {
  id            String    @id @default(cuid())
  mpPreferenceId String?  @unique 
  mpPaymentId   String?   @unique 
  status        PaymentStatus @default(PENDING)
  
  companyId     String    
  talentId      String    
  talent        User      @relation(fields: [talentId], references: [id])

  createdAt     DateTime  @default(now())
}

enum Role {
  TALENT
  COMPANY
  ADMIN
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}